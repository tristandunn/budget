<%# locals: (budget:, subcategory:, budget_snapshot:) %>
<tr id="<%= dom_id(subcategory, :row) %>" class="bg-white border-b border-taupe-300">
  <th scope="row" id="<%= dom_id(subcategory, :name) %>" class="py-2 pr-4 pl-9 text-sm font-normal">
    <label class="flex items-center gap-2 min-w-0 cursor-pointer">
      <%= check_box_tag dom_id(subcategory, :select), subcategory.id, false,
                        aria:         { label: t(".select", name: subcategory.name) },
                        autocomplete: "off",
                        class:        "shrink-0",
                        data:         {
                          selection_target: "subcategory",
                          category_id:      subcategory.parent_id,
                          subcategory_id:   subcategory.id,
                          detail_url:       budget_category_path(budget, subcategory,
                                                                 year:  budget_snapshot.date.year,
                                                                 month: budget_snapshot.date.month),
                          action:           "selection#toggle"
                        } %>

      <button
        type="button"
        class="truncate min-w-0 text-left cursor-pointer"
        data-action="selection#edit"
      >
        <%= subcategory.name %>
      </button>
    </label>
  </th>

  <td class="py-2 px-4 text-sm text-right whitespace-nowrap" data-controller="inline-edit">
    <%= turbo_frame_tag dom_id(subcategory, :assignment) do %>
      <%= link_to number_to_money(budget_snapshot.snapshot_for(subcategory.id).amount_assigned),
                  edit_budget_category_assignment_path(budget, subcategory,
                                                       year:  budget_snapshot.date.year,
                                                       month: budget_snapshot.date.month),
                  class: "text-inherit no-underline",
                  data:  {
                    action:         "click->inline-edit#prefocus click->selection#selectRow",
                    turbo_prefetch: false
                  } %>
    <% end %>
  </td>

  <td
    class="relative py-2 px-4 text-sm text-right whitespace-nowrap"
    data-action="turbo:frame-load->anchored-popover#show"
    data-controller="anchored-popover"
  >
    <%= link_to number_to_money(-budget_snapshot.snapshot_for(subcategory.id).amount_used),
                activity_budget_category_path(budget, subcategory,
                                              year:  budget_snapshot.date.year,
                                              month: budget_snapshot.date.month),
                class: "border-b border-transparent text-inherit hover:border-indigo-600 hover:text-indigo-600",
                aria:  { expanded: false },
                data:  {
                  action:                  "anchored-popover#activate",
                  anchored_popover_target: "trigger",
                  turbo_frame:             dom_id(subcategory, :activity),
                  turbo_prefetch:          false
                } %>

    <div
      class="
        group absolute top-full right-2 z-20 mt-2 hidden w-[28rem] rounded-lg border
        border-taupe-200 bg-white text-left font-normal
        shadow-[0_16px_32px_-8px_rgb(0_0_0/0.2),0_6px_12px_-4px_rgb(0_0_0/0.1)]
        translate-x-(--anchored-popover-shift) data-[placement=above]:top-auto
        data-[placement=above]:bottom-full data-[placement=above]:mt-0
        data-[placement=above]:mb-2
      "
      data-anchored-popover-target="menu"
    >
      <span
        aria-hidden="true"
        class="
          absolute -top-1.5 right-6 size-3 translate-x-(--anchored-popover-arrow-shift)
          rotate-45 border-t border-l border-taupe-200 bg-taupe-100
          group-data-[placement=above]:top-auto group-data-[placement=above]:-bottom-1.5
          group-data-[placement=above]:border-t-0 group-data-[placement=above]:border-l-0
          group-data-[placement=above]:border-r group-data-[placement=above]:border-b
          group-data-[placement=above]:bg-white
        "
      ></span>

      <div class="overflow-hidden rounded-lg">
        <%= turbo_frame_tag dom_id(subcategory, :activity) %>
      </div>
    </div>
  </td>

  <td class="py-2 px-4 text-sm text-right whitespace-nowrap">
    <%= render "categories/available",
               category:        subcategory,
               budget_snapshot: budget_snapshot %>
  </td>
</tr>
