<% content_for :title, @account.name %>

<div class="flex flex-col min-h-dvh">
  <%= render "shared/dialog", id: "account_dialog" %>

  <div class="sticky top-0 z-10 bg-white">
    <header class="grid grid-cols-3 items-center whitespace-nowrap bg-white px-4 pt-safe pb-4">
      <%= link_to budget_accounts_path(@budget), aria: { label: t(".back") }, class: "justify-self-start" do %>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
            clip-rule="evenodd"
          />
        </svg>
      <% end %>

      <h1 class="text-lg font-semibold justify-self-center"><%= @account.name %></h1>

      <%= render "accounts/transactions/actions_bar", account: @account, budget: @budget %>
    </header>

    <%= render "shared/transactions/balances",
               record:          @account,
               container_class: "border-taupe-200 px-4" %>
  </div>

  <section class="flex-1 -mt-px">
    <%= render "transactions/list",
               context:                :account,
               current_transactions:   @current_transactions,
               empty_message:          t(".empty"),
               scheduled_id:           "account-#{@account.id}-scheduled",
               scheduled_transactions: @scheduled_transactions %>
  </section>

  <%= render "shared/toolbar", budget: @budget, account_id: @account.id %>
</div>
