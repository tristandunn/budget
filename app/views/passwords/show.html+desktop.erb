<% content_for :title, t("users.password") %>

<section class="mt-8 border-t border-taupe-200 pt-8">
  <%= form_with model:  @form,
                url:    account_password_path,
                method: :patch,
                class:  "highlight-errors" do |f| %>
    <div class="mb-4">
      <%= f.label :current_password, class: "mb-1 block text-sm font-medium text-taupe-700" %>

      <div class="field-card rounded-lg border border-taupe-300">
        <div
          class="
            flex items-center px-3 py-2 rounded-lg focus-within:outline-none focus-within:ring-2
            focus-within:ring-indigo-500 focus-within:ring-inset
          "
        >
          <%= f.password_field :current_password,
                               "aria-invalid": @form.errors[:current_password].any?,
                               autocomplete:   "current-password",
                               class:          "w-full bg-transparent border-none outline-none text-base text-taupe-800 focus:ring-0",
                               required:       true %>
        </div>
      </div>

      <% if @form.errors[:current_password].present? %>
        <p role="alert" class="mt-2 text-xs text-red-700">
          <%= PasswordForm.human_attribute_name(:current_password).humanize %>
          <%= @form.errors[:current_password].first %>.
        </p>
      <% end %>
    </div>

    <div class="mb-4">
      <%= f.label :password, class: "mb-1 block text-sm font-medium text-taupe-700" %>

      <div class="field-card rounded-lg border border-taupe-300">
        <div
          class="
            flex items-center px-3 py-2 rounded-lg focus-within:outline-none focus-within:ring-2
            focus-within:ring-indigo-500 focus-within:ring-inset
          "
        >
          <%= f.password_field :password,
                               "aria-invalid": @form.errors[:password].any?,
                               autocomplete:   "new-password",
                               class:          "w-full bg-transparent border-none outline-none text-base text-taupe-800 focus:ring-0",
                               maxlength:      User::MAXIMUM_PASSWORD_LENGTH,
                               minlength:      User::MINIMUM_PASSWORD_LENGTH,
                               required:       true %>
        </div>
      </div>

      <% if @form.errors[:password].present? %>
        <p role="alert" class="mt-2 text-xs text-red-700">
          <%= PasswordForm.human_attribute_name(:password).humanize %>
          <%= @form.errors[:password].first %>.
        </p>
      <% end %>
    </div>

    <div class="mb-4">
      <%= f.label :password_confirmation, class: "mb-1 block text-sm font-medium text-taupe-700" %>

      <div class="field-card rounded-lg border border-taupe-300">
        <div
          class="
            flex items-center px-3 py-2 rounded-lg focus-within:outline-none focus-within:ring-2
            focus-within:ring-indigo-500 focus-within:ring-inset
          "
        >
          <%= f.password_field :password_confirmation,
                               "aria-invalid": @form.errors[:password_confirmation].any?,
                               autocomplete:   "new-password",
                               class:          "w-full bg-transparent border-none outline-none text-base text-taupe-800 focus:ring-0",
                               maxlength:      User::MAXIMUM_PASSWORD_LENGTH,
                               minlength:      User::MINIMUM_PASSWORD_LENGTH,
                               required:       true %>
        </div>
      </div>

      <% if @form.errors[:password_confirmation].present? %>
        <p role="alert" class="mt-2 text-xs text-red-700">
          <%= PasswordForm.human_attribute_name(:password_confirmation).humanize %>
          <%= @form.errors[:password_confirmation].first %>.
        </p>
      <% end %>
    </div>

    <div class="mt-5 flex justify-end">
      <%= f.submit t("passwords.show.submit"),
                   class: "
                     px-3 py-1.5 text-sm font-medium text-white bg-indigo-600 rounded-lg cursor-pointer
                     hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-2
                     focus-visible:ring-indigo-500 focus-visible:ring-offset-2
                   " %>
    </div>
  <% end %>
</section>
