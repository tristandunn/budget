<% content_for :title, t("settings.navigation.sessions") %>

<ul class="mt-8 divide-y divide-taupe-200 border-y border-taupe-200">
  <% @sessions.each do |record| %>
    <li class="flex gap-4 justify-between items-center py-4">
      <div class="min-w-0">
        <p class="truncate text-sm font-medium text-taupe-800">
          <%= device_description(record.user_agent) %>
        </p>

        <p class="mt-1 text-xs text-taupe-600">
          <%= l(record.created_at.to_date, format: :full_date) %> &middot;
          <%= record.ip_address.presence || t("settings.sessions.index.unknown_location") %>
          <% if record == Current.session %>
            <span class="font-medium text-indigo-700">(<%= t("settings.sessions.index.current") %>)</span>
          <% end %>
        </p>
      </div>

      <% if record != Current.session %>
        <%= button_to t("settings.sessions.index.revoke.submit"),
                      account_session_path(record),
                      method: :delete,
                      data:   { turbo_confirm: t("settings.sessions.index.revoke.confirmation") },
                      class:  "
                        shrink-0 px-3 py-1.5 text-sm font-medium text-taupe-700 border border-taupe-300
                        rounded-lg cursor-pointer hover:bg-red-50 hover:border-red-300 hover:text-red-600
                        focus-visible:outline-none focus-visible:ring-2
                        focus-visible:ring-red-500 focus-visible:ring-offset-2 focus-visible:ring-offset-taupe-50
                      " %>
      <% end %>
    </li>
  <% end %>
</ul>
