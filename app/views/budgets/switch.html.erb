<%= turbo_frame_tag "budget_switch_dialog", class: "flex flex-col h-full" do %>
  <header class="relative p-4">
    <h2 id="budget_switch_dialog_title" class="text-lg font-semibold text-center">
      <%= t(".title") %>
    </h2>

    <button
      type="button"
      data-action="dialog#close"
      class="absolute top-4 right-4 text-sm text-taupe-600"
    >
      <%= t(".done") %>
    </button>
  </header>

  <div class="flex-1 min-h-0 overflow-y-auto px-4 pb-4">
    <ul id="budget-list" class="divide-y divide-taupe-200 overflow-hidden rounded-xl bg-white">
      <% @budgets.each do |budget| %>
        <li>
          <%= link_to budget_path(budget),
                      aria:  { current: (budget == @budget ? "true" : nil) },
                      data:  { turbo_frame: "_top" },
                      class: "flex items-center justify-between gap-4 px-4 py-3 text-taupe-800 no-underline" do %>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              class="h-4 w-4 shrink-0 text-taupe-800"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M4.75 0a.75.75 0 0 1 .75.75V2h5V.75a.75.75 0 0 1 1.5 0V2h1.25c.966 0 1.75.784 1.75 1.75v10.5A1.75 1.75 0 0 1 13.25 16H2.75A1.75 1.75 0 0 1 1 14.25V3.75C1 2.784 1.784 2 2.75 2H4V.75A.75.75 0 0 1 4.75 0ZM2.5 7.5v6.75c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25V7.5Zm10.75-4H2.75a.25.25 0 0 0-.25.25V6h11V3.75a.25.25 0 0 0-.25-.25Z"
              />
            </svg>

            <span class="min-w-0 flex-1 truncate"><%= budget.name %></span>

            <% if budget == @budget %>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 16 16"
                class="h-4 w-4 shrink-0 text-taupe-800"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207Z"
                />
              </svg>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
