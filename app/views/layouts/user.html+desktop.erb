<% content_for :content do %>
  <div class="flex h-dvh">
    <aside class="flex w-72 shrink-0 flex-col bg-indigo-950 text-indigo-100">
      <div class="shrink-0 px-5 py-4">
        <%= link_to root_path,
                    class: "
                      -ml-2 inline-flex items-center gap-2 rounded-lg px-2 py-1 text-sm text-indigo-200
                      no-underline hover:bg-white/5 hover:text-white focus-visible:outline-none
                      focus-visible:ring-2 focus-visible:ring-indigo-400
                    " do %>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 16 16"
            class="h-4 w-4 shrink-0"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M9.78 12.78a.75.75 0 0 1-1.06 0L4.47 8.53a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 1.06L6.06 8l3.72 3.72a.75.75 0 0 1 0 1.06Z"
            />
          </svg>

          <%= t("users.layout.back") %>
        <% end %>
      </div>

      <nav aria-label="<%= t("users.layout.navigation") %>" class="flex-1 overflow-y-auto px-3">
        <h2 class="px-3 pb-2 text-xs uppercase tracking-wide text-indigo-300">
          <%= t("users.account") %>
        </h2>

        <ul class="space-y-1">
          <li>
            <%= link_to t("users.settings"),
                        account_path,
                        aria:  { current: (current_page?(account_path) ? "page" : nil) },
                        class: class_names(sidebar_item_class(active: current_page?(account_path)), "text-sm") %>
          </li>

          <li>
            <%= link_to t("users.password"),
                        account_password_path,
                        aria:  { current: (current_page?(account_password_path) ? "page" : nil) },
                        class: class_names(sidebar_item_class(active: current_page?(account_password_path)), "text-sm") %>
          </li>
        </ul>
      </nav>
    </aside>

    <main class="min-w-0 flex-1 overflow-y-auto bg-white">
      <div class="mx-auto max-w-2xl px-8 py-10">
        <h1 class="text-2xl font-semibold text-taupe-800"><%= content_for(:title) %></h1>

        <% if notice.present? %>
          <p
            role="status"
            class="
              mt-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm
              text-green-800
            "
          >
            <%= notice %>
          </p>
        <% end %>

        <%= yield %>
      </div>
    </main>
  </div>
<% end %>

<%= render template: "layouts/application" %>
